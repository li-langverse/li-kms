# Li KMS persistence demo - bootstrap a KEK, wrap a project DEK, persist both
# (base64 via binary-safe file I/O externs), reload, and verify the round-trip.
# Returns 0 on success.

import std.runtime.seam

def buf_eq(a: ptr, b: ptr, n: int) raises IO -> int
  requires 0 <= n
  ensures result == 0 or result == 1
  decreases 0
=
  var i: int = 0
  while i < n:
    if net_byte_at_i(a, i) != net_byte_at_i(b, i):
      return 0
    i = i + 1
  return 1

def main() raises IO, Alloc -> int
  requires true
  ensures result == 0 or result == 1 or result == 2 or result == 3 or result == 4
  decreases 0
=
  var kek: ptr = net_buf_alloc(32)
  var r0: int = li_rt_rng_fill_bytes(kek, 32)
  var b64: ptr = net_buf_alloc(64)
  var en0: int = li_rt_b64_encode(kek, 32, b64)
  var w0: int = li_rt_file_write_bytes("/tmp/kms_kek.b64", b64, en0)
  var read0: ptr = net_buf_alloc(64)
  var rn0: int = li_rt_file_read_bytes("/tmp/kms_kek.b64", read0, 64)
  var kek2: ptr = net_buf_alloc(32)
  var dn0: int = li_rt_b64_decode(read0, rn0, kek2)
  if buf_eq(kek, kek2, 32) != 1:
    return 1
  var dek: ptr = net_buf_alloc(32)
  var r1: int = li_rt_rng_fill_bytes(dek, 32)
  var nonce: ptr = net_buf_alloc(24)
  var mac: ptr = net_buf_alloc(16)
  var ct: ptr = net_buf_alloc(32)
  var r2: int = li_rt_rng_fill_bytes(nonce, 24)
  li_rt_crypto_lock(mac, ct, dek, 32, kek, nonce)
  var mb64: ptr = net_buf_alloc(64)
  var men: int = li_rt_b64_encode(mac, 16, mb64)
  var mw: int = li_rt_file_write_bytes("/tmp/kms_mac.b64", mb64, men)
  var nb64: ptr = net_buf_alloc(64)
  var nen: int = li_rt_b64_encode(nonce, 24, nb64)
  var nw: int = li_rt_file_write_bytes("/tmp/kms_nonce.b64", nb64, nen)
  var cb64: ptr = net_buf_alloc(64)
  var cen: int = li_rt_b64_encode(ct, 32, cb64)
  var cw: int = li_rt_file_write_bytes("/tmp/kms_ct.b64", cb64, cen)
  var mac2: ptr = net_buf_alloc(16)
  var nonce2: ptr = net_buf_alloc(24)
  var ct2: ptr = net_buf_alloc(32)
  var mrb: ptr = net_buf_alloc(64)
  var mrn: int = li_rt_file_read_bytes("/tmp/kms_mac.b64", mrb, 64)
  var mdn: int = li_rt_b64_decode(mrb, mrn, mac2)
  var nrb: ptr = net_buf_alloc(64)
  var nrn: int = li_rt_file_read_bytes("/tmp/kms_nonce.b64", nrb, 64)
  var ndn: int = li_rt_b64_decode(nrb, nrn, nonce2)
  var crb: ptr = net_buf_alloc(64)
  var crn: int = li_rt_file_read_bytes("/tmp/kms_ct.b64", crb, 64)
  var cdn: int = li_rt_b64_decode(crb, crn, ct2)
  var dek2: ptr = net_buf_alloc(32)
  var un: int = li_rt_crypto_unlock(dek2, mac2, ct2, 32, kek2, nonce2)
  if un != 0:
    return 2
  if buf_eq(dek, dek2, 32) != 1:
    return 3
  var seed: ptr = net_buf_alloc(32)
  var r3: int = li_rt_rng_fill_bytes(seed, 32)
  var sk: ptr = net_buf_alloc(64)
  var pk: ptr = net_buf_alloc(32)
  li_rt_crypto_ed25519_keypair(pk, sk, seed)
  var msg: ptr = net_buf_alloc(8)
  li_rt_vec_i32_set(msg, 0, 12345)
  li_rt_vec_i32_set(msg, 1, 67890)
  var sig: ptr = net_buf_alloc(64)
  li_rt_crypto_ed25519_sign(sig, msg, 8, sk)
  var ok: int = li_rt_crypto_ed25519_verify(sig, msg, 8, pk)
  if ok != 0:
    return 4
  return 0
